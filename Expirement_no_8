# Python program to demonstrate multilevel inheritance[cite: 18]

# Base class[cite: 19]
class Grandfather:[cite: 19]
    def __init__(self, grandfathername):[cite: 19]
        self.grandfathername = grandfathername[cite: 19]

# Intermediate class[cite: 19]
class Father(Grandfather):[cite: 19]
    def __init__(self, fathername, grandfathername):[cite: 19]
        self.fathername = fathername[cite: 19]
        # invoking constructor of Grandfather class[cite: 19]
        Grandfather.__init__(self, grandfathername)[cite: 19]

# Derived class[cite: 19]
class Son(Father):[cite: 19]
    def __init__(self, sonname, fathername, grandfathername):[cite: 19]
        self.sonname = sonname[cite: 19]
        # invoking constructor of Father class[cite: 19]
        Father.__init__(self, fathername, grandfathername)[cite: 19]

    def print_name(self):[cite: 19]
        print("Grandfather name :", self.grandfathername)[cite: 19]
        print("Father name :", self.fathername)[cite: 19]
        print("Son name :", self.sonname)[cite: 19]

# Driver code[cite: 19]
s1 = Son("Prince", "Rampal", "Lal mani")[cite: 19]
print(s1.grandfathername)[cite: 19]
s1.print_name()[cite: 19]

