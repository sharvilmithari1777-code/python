# 10. Prime or not
n = int(input("Enter a number: "))
if n < 2:
    print("Not prime")
else:
    i = 2
    prime = True
    while i * i <= n:
        if n % i == 0:
            prime = False
            break
        i += 1
    if prime:
        print("Prime")
    else:
        print("Not prime")

# 11. Sum of digits
n = int(input("Enter a number: "))
total = 0
while n > 0:
    total += n % 10
    n //= 10
print("Sum of digits =", total)

# 12. Palindrome or not
n = int(input("Enter a number: "))
temp = n
rev = 0
while temp > 0:
    rev = rev * 10 + temp % 10
    temp //= 10
if rev == n:
    print("Palindrome")
else:
    print("Not a palindrome")

