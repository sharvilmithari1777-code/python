# 5. Sum of 1 + 1/1! + 1/2! + 1/3! + ... + 1/n!
n = int(input("Enter n: "))
total = 1
fact = 1
for i in range(1, n + 1):
    fact = fact * i
    total = total + 1 / fact
print("Sum =", total)

# 6. Cosine series: cos(x) = 1 - x^2/2! + x^4/4! - x^6/6! + ...
x = float(input("Enter x (in radians): "))
n = int(input("Enter number of terms: "))
total = 0
fact = 1
for i in range(n):
    if i > 0:
        fact = fact * (2 * i - 1) * (2 * i)
    total = total + ((-1) ** i) * (x ** (2 * i)) / fact
print("cos(x) =", total)

# 7. Check whether the square root of a number is prime
n = int(input("Enter a number: "))
root = int(n ** 0.5)
if root * root != n:
    print("Square root is not an integer, so it is not prime")
elif root < 2:
    print("Square root", root, "is not prime")
else:
    prime = True
    for i in range(2, int(root ** 0.5) + 1):
        if root % i == 0:
            prime = False
            break
    if prime:
        print("Square root", root, "is prime")
    else:
        print("Square root", root, "is not prime")

