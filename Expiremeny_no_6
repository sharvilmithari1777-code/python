import os[cite: 3]

# 1. Getting the Current Working Directory (CWD)[cite: 3]
current_dir = os.getcwd()  # os.getcwdb() returns a byte string[cite: 3]
print("Current Directory:", current_dir)

# 2. Creating a New Directory[cite: 3]
os.mkdir("new_dir")  # creates in current working directory[cite: 3]
# Example specifying path: os.mkdir(r"D:\new_dir")[cite: 3]

# 3. Changing Current Working Directory[cite: 3]
os.chdir("new_dir")[cite: 3]

# 4. Listing Files and Directories[cite: 3]
print(os.listdir())  # lists files/folders in CWD[cite: 3]

# 5. Renaming a Directory or File[cite: 3]
# os.rename(old_name, new_name)[cite: 3]
# os.renames(old_name, new_name) moves renamed file to specified destination directory[cite: 3]
os.rename("old_name", "new_name")[cite: 3]

# 6. Removing an Empty Directory[cite: 3]
os.rmdir("new_dir")  # raises OSError if directory is not empty[cite: 3]

import os.path[cite: 4]
import datetime[cite: 4]

path = "geek.txt"

# Check whether it is a directory[cite: 4]
is_dir = os.path.isdir(path)[cite: 4]

# Get size of file/directory in bytes[cite: 4]
size_bytes = os.path.getsize(path)[cite: 4]

# Access and modification times (epoch timestamps)[cite: 4]
access_time = os.path.getatime(path)[cite: 4]
mod_time = os.path.getmtime(path)[cite: 4]

# Formatting timestamps into human-readable date/time[cite: 4]
formatted_mod_time = datetime.datetime.fromtimestamp(mod_time)[cite: 4]

import filecmp[cite: 4]

# Compare two directories[cite: 4]
d = filecmp.dircmp("dir_1", "dir_2", ignore=["a.txt", "b.txt"], hide=["c.txt", "d.txt"])[cite: 4]

# Print comparison reports[cite: 4]
d.report()                 # Compares the two directories and common sub-directories[cite: 4]
d.report_partial_closure() # Compares directories and common immediate sub-directories[cite: 4]
d.report_full_closure()    # Recursively compares all sub-directories[cite: 4]

